# Supabase project (Settings > API). The publishable key is safe in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Same values for server-side rendering
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_ID=your-project-ref

# Server only. Used to create the demo staff accounts. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the deployed site, no trailing slash. QR codes and share images use it.
VITE_SITE_URL=https://padelion.example.com
